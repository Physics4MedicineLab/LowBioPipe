/*
================================================================================
    LowBioPipe Configuration
================================================================================
    Post-taxprofiler processing for low biomass microbiome analysis
================================================================================
*/

params {
    // Required inputs
    taxprofiler_results  = null
    kraken2_db_name      = null

    // Reference data
    taxdump              = "${projectDir}/data/taxdump"
    exclude_taxa         = "${projectDir}/config/contaminants_example.txt"

    // Sample configuration (comma-separated IDs)
    samples              = null
    controls             = null
    groups_file          = null

    // Output
    outdir               = 'results'

    // Contaminant filtering
    filter_include_ancestors    = false
    filter_ancestors_max_rank   = 'genus'
    filter_include_descendants  = false

    // Recentrifuge
    recentrifuge_min_score      = 10

    // Abundance tables
    abundance_ranks             = 'species,genus,phylum'
    abundance_source            = 'auto'
    abundance_aggregate         = true
    abundance_min_count         = 1
    abundance_min_samples       = 2
    abundance_relative          = true
    abundance_keep_unranked     = false

    // Diversity analysis
    diversity_heatmap_top_n     = 50
}

plugins {
    id 'nf-schema@2.7.3'
}

validation {
    help {
        enabled = true
        command = 'nextflow run main.nf --taxprofiler_results <dir> --kraken2_db_name <db> --samples S1,S2,S3,S4 --controls BLANK1,BLANK2 -profile docker'
    }
}

profiles {
    docker {
        docker.enabled       = true
        docker.runOptions    = '-u $(id -u):$(id -g)'
        singularity.enabled  = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    conda {
        conda.enabled        = true
        docker.enabled       = false
        singularity.enabled  = false
    }
    test {
        params.taxprofiler_results = "${projectDir}/test_data/taxprofiler_output"
        params.kraken2_db_name     = 'testdb'
        params.taxdump             = "${projectDir}/test_data/taxdump"
        params.exclude_taxa        = "${projectDir}/test_data/contaminants.txt"
        params.samples             = 'S1,S2,S3,patient_01,patient_02'
        params.controls            = 'BLANK1'
        params.groups_file         = "${projectDir}/test_data/groups.tsv"
        process.resourceLimits     = [cpus: 2, memory: 6.GB, time: 1.h]
    }
}

process {
    cpus   = { 2 * task.attempt }
    memory = { 8.GB * task.attempt }
    time   = { 4.h * task.attempt }

    // Upper bounds for any task; override in a custom config (-c) to fit your machine
    resourceLimits = [cpus: 16, memory: 64.GB, time: 24.h]

    errorStrategy = { task.exitStatus in [143, 137] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = 10

    withLabel: 'process_low' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
}

manifest {
    name            = 'LowBioPipe'
    author          = 'LowBioPipe Contributors'
    description     = 'Post-taxprofiler processing for low biomass microbiome analysis'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.10.0'
    version         = '0.2.0'
}
